{
  "name": "senseki-capture",
  "productName": "SENSEKI SCAN",
  "version": "1.0.2",
  "description": "マリオテニスフィーバーの対戦録画からSENSEKI FEVER用の戦績CSVを自動生成するローカルアプリ",
  "main": "main.js",
  "author": "ガメス",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "predist": "node -e \"const p=require('ffmpeg-static');if(!require('fs').existsSync(p)){console.error('ffmpeg-static のバイナリがありません。app で: node node_modules/ffmpeg-static/install.js');process.exit(1)}\""
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.gamesu.senseki-capture",
    "productName": "SENSEKI SCAN",
    "files": [
      "main.js",
      "hl-ffmpeg.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "installer.nsh"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "games-desu",
        "repo": "senseki-scan"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SENSEKI-SCAN-Setup-${version}.exe",
      "include": "installer.nsh"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  }
}
