{
  "name": "senseki-capture",
  "productName": "SENSEKI SCAN",
  "version": "0.3.13",
  "description": "マリオテニスフィーバーの対戦録画からSENSEKI FEVER用の戦績CSVを自動生成するローカルアプリ",
  "main": "main.js",
  "author": "ガメス",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.gamesu.senseki-capture",
    "productName": "SENSEKI SCAN",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "installer.nsh"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "games-desu",
        "repo": "senseki-scan"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SENSEKI-SCAN-Setup-${version}.exe",
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
